-MEN_FORDS_SOURCE_ENTRY_COUNT = 335 + 56 + 5
+# The current base profile resolves 331 per-resource asset/data rows, plus the
+# 7 rows of the five map rules (``fords-map-binary``, ``fords-map-scripts``,
+# ``fords-map-config``, ``fords-map-art``, ``fords-map-preview``), plus the
+# 56 documents the living-world strategic rule resolves from the BFME2 1.06
+# catalog (the riskcampaign #include closure and its entry points).
+#
+# This used to read ``335 + 56 + 5``, which was wrong by two in a way nobody
+# could see: 335 counted four rows that no rule produces, while 5 claimed the
+# map-script composite owns four AI libraries.  It owns two.  The profile's
+# ``fords-map-scripts`` declares map + ``ai_initialize`` +
+# ``ai_mp_inherit_management`` and passes ``libraryVirtualPaths`` equal to
+# ``legacy_libraries``; the four-library closure (``base_libraries``) is an
+# allowed alternative the Fords profile does not use.  The totals happened to
+# land at 394 against every clean BFME2 1.06 install.  A count is only useful
+# if it is TRUE, so it is written as the sum of what the rules actually yield.
+#
+# Measured on a clean BFME2 1.06 (BFME Arena sync): 331 + 7 + 56 = 394.
+#
+# Provenance is per resource, not a unique-physical-source census: intentional
+# W3D source variants therefore remain separate auditable rows.
+MEN_FORDS_SOURCE_ENTRY_COUNT = 331 + 7 + 56
 MAX_RENDERED_OUTPUT_PATH = 512
 W3D_ADAPTER_REPORT_CONTRACT = "openbfme.w3d-adapter-report"
